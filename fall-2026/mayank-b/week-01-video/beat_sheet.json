            "at": "No question",
            "event": "input list shown beside the signature: logits, temperature — nothing else"
          },
          {
            "at": "zero is rejected",
            "event": "the `temperature <= 0` guard line highlighted"
          }
        ],
        "remotion": {
          "pattern": "TcCode",
          "props": {
            "sparkLine": "One division. No evidence.",
            "code": "def probabilities(logits, temperature=1.0):\n    if not logits or not math.isfinite(temperature) or temperature <= 0:\n        raise ValueError(\"Need logits and a positive finite temperature\")\n    if not all(math.isfinite(x) for x in logits):\n        raise ValueError(\"Logits must be finite\")\n    peak = max(logits)\n    weights = [math.exp((x - peak) / temperature) for x in logits]\n    total = sum(weights)\n    return [weight / total for weight in weights]",
            "title": "main.py · probabilities()",
